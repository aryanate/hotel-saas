# ============================================================
# HotelSaaS Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in values for local dev.

# API base URL — LEAVE EMPTY for local dev with Vite proxy.
# If set to http://localhost:5208, mobile devices on the same
# Wi-Fi will get ERR_NETWORK (localhost resolves to the phone itself).
VITE_API_URL=

# App display name
VITE_APP_NAME=HotelSaaS
