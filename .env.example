# Database
DB_CONNECTION_STRING=Server=localhost;Database=HotelSaasDb;Trusted_Connection=True;TrustServerCertificate=True;

# JWT Authentication
JWT_SECRET=YOUR_32_CHARACTER_OR_LONGER_SECRET_KEY_HERE
JWT_ISSUER=HotelSaaS
JWT_AUDIENCE=HotelSaaSClients
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Object Storage (Local / AWS S3 / Azure Blob)
STORAGE_PROVIDER=Local
STORAGE_LOCAL_PATH=uploads
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=hotelsaas-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_PROVIDER=Mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=hotelsaas_webhook_secret

# Frontend Configuration
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

